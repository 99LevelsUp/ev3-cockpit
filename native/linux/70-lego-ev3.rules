# LEGO MINDSTORMS EV3 (USB 0694:0005): read and write access for the user.
# TAG+="uaccess" gives it to the user at the seat where systemd-logind or elogind runs;
# GROUP="plugdev" gives it to members of plugdev where neither runs (runit, OpenRC, ...).
# Install:  sudo cp 70-lego-ev3.rules /etc/udev/rules.d/ && sudo udevadm control --reload
# then plug the brick in again.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0694", ATTRS{idProduct}=="0005", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0694", ATTRS{idProduct}=="0005", MODE="0660", GROUP="plugdev", TAG+="uaccess"
