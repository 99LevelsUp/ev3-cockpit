{
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": false
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"files.exclude": {
		"out": false
	},
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/out/**": true,
		"**/.git/**": true
	},
	"json.schemaDownload.enable": false
}
