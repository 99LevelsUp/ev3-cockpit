/**
 * The daemon-client contract's generator and gate.
 *
 * `contract/schema/*.json` (JSON Schema draft-07) holds every type; `contract/methods.json` is the
 * method table: requests, notifications, the request the daemon sends a client, error codes with
 * their families, and the contract version. This script checks the rules the schema must follow,
 * compares the contract with the last released one, and writes the TypeScript side into
 * `src/contract/generated/`. The Rust side is generated by the `ev3-contract` crate's build script
 * from the same files.
 *
 *   node scripts/generate-contract.mts              write src/contract/generated/
 *   node scripts/generate-contract.mts --check      fail when a generated file is stale, a rule is
 *                                                   broken, or a breaking change lacks a raised
 *                                                   contract version
 *   node scripts/generate-contract.mts --snapshot   record the contract as released in
 *                                                   contract/released/ (part of a release)
 *
 * Rules: no anyOf; a oneOf only when every branch requires the same property with a distinct
 * const value; every $ref names a definition; no object closed to unknown properties (an older
 * daemon would refuse a newer client's optional field); stable-core definitions say
 * additionalProperties true on every object and refer only to the stable core.
 *
 * The contract version marks only breaking changes: a removed or renamed method, notification,
 * field or error code, a field that changes type or becomes required or optional, a removed enum
 * value or union variant, a new enum value or union variant in what the daemon reads (request
 * parameters, a question's answer, the files), an error code moved to another family. Additive
 * changes keep it: a new optional field, method, notification, error code in an existing family,
 * or a new value in what only clients read. The stable core never changes except by a new optional
 * property, whatever the version says.
 */

import * as fs from 'node:fs';
import * as path from 'node:path';
import * as crypto from 'node:crypto';
import { createRequire } from 'node:module';

const require = createRequire(import.meta.url);
const ROOT = path.join(import.meta.dirname, '..');
const DEFAULT_PATHS = {
	contractDir: path.join(ROOT, 'contract'),
	outDir: path.join(ROOT, 'src', 'contract', 'generated'),
};
const DRAFT = 'http://json-schema.org/draft-07/schema#';
export const NO_SNAPSHOT = 'No released snapshot in contract/released/: the compatibility comparison is skipped until the first release.';

// ── The contract's shape ────────────────────────────────────────────

/**
 * A schema as the contract writes it. Only the keywords the generator reads are named; the files
 * are checked by the rules below, not trusted to follow these types.
 */
export interface Schema {
	$ref?: string;
	type?: string | string[];
	properties?: Record<string, Schema>;
	required?: string[];
	items?: Schema | Schema[];
	additionalProperties?: boolean | Schema;
	oneOf?: Schema[];
	anyOf?: Schema[];
	allOf?: Schema[];
	enum?: unknown[];
	const?: unknown;
	default?: unknown;
	description?: string;
	definitions?: Record<string, Schema>;
	'x-stableCore'?: boolean;
	'x-readAs'?: string;
	'x-unknownReadsAs'?: string;
	'x-cliKey'?: string;
	'x-dangerous'?: boolean;
	'x-stored'?: boolean;
	'x-file'?: unknown;
	[keyword: string]: unknown;
}

type Definitions = Record<string, Schema>;

interface Documented { doc?: string }
interface CallEntry extends Documented { params: string | null; result: string | null }
interface MethodEntry extends CallEntry {
	leased: boolean;
	needsPerson: boolean;
	stableCore?: boolean;
	callableBy: string[];
}
interface NotificationEntry extends Documented { payload: string }
interface FamilyEntry extends Documented { number: number }
interface ErrorEntry extends Documented { family: string }

/** `contract/methods.json`. */
export interface MethodTable {
	contractVersion: number;
	hello: Record<string, CallEntry>;
	methods: Record<string, MethodEntry>;
	notifications: Record<string, NotificationEntry>;
	clientRequests: Record<string, CallEntry>;
	errorFamilies: Record<string, FamilyEntry>;
	errors: Record<string, ErrorEntry>;
	[field: string]: unknown;
}

export interface Contract {
	definitions: Definitions;
	table: MethodTable;
	problems?: string[];
}

export interface Paths {
	readonly contractDir?: string;
	readonly outDir?: string;
}

export interface Outcome {
	ok: boolean;
	problems: string[];
	notes?: string[];
	written?: string[];
}

// ── Loading ─────────────────────────────────────────────────────────

function readJson<T>(file: string): T {
	try {
		return JSON.parse(fs.readFileSync(file, 'utf8')) as T;
	} catch (error) {
		throw new Error(`${file}: ${(error as Error).message}`);
	}
}

/** The schema files' definitions merged into one map, and the method table. */
export function loadContract(contractDir: string): Contract {
	const schemaDir = path.join(contractDir, 'schema');
	const files = fs.readdirSync(schemaDir).filter((f) => f.endsWith('.json')).sort();
	const definitions: Definitions = {};
	const problems: string[] = [];
	for (const file of files) {
		const schema = readJson<Schema>(path.join(schemaDir, file));
		if (!schema.definitions || typeof schema.definitions !== 'object') {
			problems.push(`schema/${file} has no definitions.`);
			continue;
		}
		for (const [name, definition] of Object.entries(schema.definitions)) {
			if (name in definitions) { problems.push(`${name} is defined twice (schema/${file}).`); continue; }
			definitions[name] = definition;
		}
	}
	return { definitions, table: readJson<MethodTable>(path.join(contractDir, 'methods.json')), problems };
}

/** The last released contract, or undefined before the first release. */
function loadReleased(contractDir: string): Contract | undefined {
	const dir = path.join(contractDir, 'released');
	const schemaFile = path.join(dir, 'schema.json');
	if (!fs.existsSync(schemaFile)) { return undefined; }
	return { definitions: readJson<Schema>(schemaFile).definitions as Definitions, table: readJson<MethodTable>(path.join(dir, 'methods.json')) };
}

/** JSON with every object's keys sorted, so the same contract always gives the same text. */
function canonical(value: unknown): string | undefined {
	if (Array.isArray(value)) { return `[${value.map(canonical).join(',')}]`; }
	if (value && typeof value === 'object') {
		const object = value as Record<string, unknown>;
		return `{${Object.keys(object).sort().map((k) => `${JSON.stringify(k)}:${canonical(object[k])}`).join(',')}}`;
	}
	return JSON.stringify(value);
}

function schemaHash(contract: Contract): string {
	return crypto.createHash('sha256').update(canonical({ definitions: contract.definitions, table: contract.table }) as string).digest('hex');
}

// ── Rules ───────────────────────────────────────────────────────────

const REF = /^#\/definitions\/([A-Za-z0-9]+)$/;

function refName(schema: Schema): string | undefined {
	const match = typeof schema.$ref === 'string' ? REF.exec(schema.$ref) : null;
	return match ? match[1] : undefined;
}

/** Calls `visit` on the schema and every schema inside it. */
function walk(schema: Schema | undefined, where: string, visit: (schema: Schema, where: string) => void): void {
	if (!schema || typeof schema !== 'object') { return; }
	visit(schema, where);
	for (const [name, property] of Object.entries(schema.properties ?? {})) { walk(property, `${where}.${name}`, visit); }
	if (Array.isArray(schema.items)) { schema.items.forEach((s, i) => walk(s, `${where}[${i}]`, visit)); } else { walk(schema.items, `${where}[]`, visit); }
	if (schema.additionalProperties && typeof schema.additionalProperties === 'object') { walk(schema.additionalProperties, `${where}{}`, visit); }
	for (const key of ['oneOf', 'anyOf', 'allOf'] as const) {
		(schema[key] ?? []).forEach((s, i) => walk(s, `${where}<${key}${i}>`, visit));
	}
}

/** The property every branch requires with a const value, or undefined. */
function unionTag(schema: Schema): string | undefined {
	const branches = schema.oneOf as Schema[];
	const first = branches[0];
	if (!first || !first.properties) { return undefined; }
	return Object.keys(first.properties).find((name) => branches.every((b) =>
		b && b.properties && b.properties[name] && 'const' in b.properties[name]
		&& Array.isArray(b.required) && b.required.includes(name)));
}

/** A property read as an enum (x-readAs): where it is, its schema, the enum and what an unknown string reads as. */
interface Reader {
	where: string;
	schema: Schema;
	enumName: string;
	fallback: string | undefined;
}

/** Every property read as an enum (x-readAs), with the value an unknown string reads as. */
function openReaders(definitions: Definitions): Reader[] {
	const readers: Reader[] = [];
	for (const [name, definition] of Object.entries(definitions)) {
		for (const [property, schema] of Object.entries(definition.properties ?? {})) {
			if (schema && schema['x-readAs'] !== undefined) {
				readers.push({ where: `${name}.${property}`, schema, enumName: schema['x-readAs'], fallback: schema['x-unknownReadsAs'] });
			}
		}
	}
	return readers;
}

/** An enum read from stable-core strings: its name, its values and what an unknown string reads as. */
interface OpenEnum {
	name: string;
	values: string[];
	fallback: string | undefined;
}

/** One reader per enum: the enum's name, its values and what an unknown string reads as. */
function openEnums(definitions: Definitions): OpenEnum[] {
	const byName = new Map<string, OpenEnum>();
	for (const reader of openReaders(definitions)) {
		if (!byName.has(reader.enumName)) {
			byName.set(reader.enumName, { name: reader.enumName, values: definitions[reader.enumName].enum as string[], fallback: reader.fallback });
		}
	}
	return [...byName.values()];
}

function isObjectSchema(schema: Schema): boolean {
	return schema.type === 'object' || (schema.properties !== undefined && schema.type === undefined);
}

export function lint(contract: Contract): string[] {
	const problems = [...(contract.problems ?? [])];
	const { definitions, table } = contract;

	for (const [name, definition] of Object.entries(definitions)) {
		if (!/^[A-Z][A-Za-z0-9]*$/.test(name)) { problems.push(`${name}: definition names are UpperCamelCase.`); }
		const core = definition['x-stableCore'] === true;
		walk(definition, name, (schema, where) => {
			if (schema.anyOf) { problems.push(`${where}: anyOf is not allowed; use a oneOf with a const tag.`); }
			if (schema.oneOf) {
				const tag = unionTag(schema);
				if (!tag) {
					problems.push(`${where}: a oneOf needs a const tag, one property every branch requires with a const value.`);
				} else {
					const values = schema.oneOf.map((b) => (b.properties as Record<string, Schema>)[tag].const);
					if (new Set(values).size !== values.length) { problems.push(`${where}: the oneOf's ${tag} values are not distinct.`); }
				}
			}
			if (schema.$ref !== undefined) {
				const target = refName(schema);
				if (!target || !(target in definitions)) {
					problems.push(`${where}: $ref ${schema.$ref} names no definition.`);
				} else if (core && definitions[target]['x-stableCore'] !== true) {
					problems.push(`${where}: the stable core refers to ${target}, which is not on the stable core.`);
				}
			}
			if (schema.additionalProperties === false) {
				problems.push(`${where}: objects stay open to unknown properties, so an older reader accepts a newer writer's optional field.`);
			}
			if (core && isObjectSchema(schema) && schema.additionalProperties !== true) {
				problems.push(`${where}: a stable-core object says additionalProperties true.`);
			}
			if (core && (schema.enum || schema.oneOf)) {
				problems.push(`${where}: the stable core holds no enum or union, since an older version could not read a value added later; use a string with x-readAs.`);
			}
			if (schema['x-readAs'] !== undefined && !Object.values(definition.properties ?? {}).includes(schema)) {
				problems.push(`${where}: x-readAs goes only on a property directly under a definition.`);
			}
		});
	}
	const fallbacks = new Map<string, string | undefined>();
	for (const reader of openReaders(definitions)) {
		const target = definitions[reader.enumName] as Schema | undefined;
		const where = `${reader.where} x-readAs ${reader.enumName}`;
		if (reader.schema.type !== 'string') { problems.push(`${where}: a property read as an enum is a string.`); }
		if (!target || !Array.isArray(target.enum)) { problems.push(`${where}: names no enum definition.`); continue; }
		if (!target.enum.includes(reader.fallback)) { problems.push(`${where}: x-unknownReadsAs ${reader.fallback} is not one of its values.`); }
		if (fallbacks.has(reader.enumName) && fallbacks.get(reader.enumName) !== reader.fallback) {
			problems.push(`${where}: another property reads an unknown ${reader.enumName} as ${fallbacks.get(reader.enumName)}.`);
		}
		fallbacks.set(reader.enumName, reader.fallback);
	}

	const isDefinition = (name: unknown): name is string => typeof name === 'string' && name in definitions;
	const isMessage = (name: unknown): boolean => isDefinition(name) && (isObjectSchema(definitions[name]) || Array.isArray(definitions[name].oneOf));
	const isCore = (name: unknown): boolean => isDefinition(name) && definitions[name]['x-stableCore'] === true;
	const clientKinds = (definitions.ClientKind as Schema | undefined)?.enum ?? [];

	if (!Number.isInteger(table.contractVersion) || table.contractVersion < 1) {
		problems.push('methods.json: contractVersion is a positive integer.');
	}
	for (const section of ['hello', 'methods', 'notifications', 'clientRequests', 'errorFamilies', 'errors']) {
		if (!table[section] || typeof table[section] !== 'object') { problems.push(`methods.json: ${section} is missing.`); table[section] = {}; }
	}
	for (const [name, entry] of Object.entries(table.hello)) {
		if (!isCore(entry.params) || !isCore(entry.result)) { problems.push(`hello ${name}: params and result are stable-core definitions.`); }
	}
	for (const [name, entry] of Object.entries(table.methods)) {
		const where = `method ${name}`;
		if (!/^[a-z]+\/[a-z][A-Za-z]*$/.test(name)) { problems.push(`${where}: names are area/action.`); }
		if (!isMessage(entry.params)) { problems.push(`${where}: params ${entry.params} is not an object definition.`); }
		if (entry.result !== null && !isMessage(entry.result)) { problems.push(`${where}: result ${entry.result} is neither null nor an object definition.`); }
		for (const flag of ['leased', 'needsPerson'] as const) {
			if (typeof entry[flag] !== 'boolean') { problems.push(`${where}: ${flag} is true or false.`); }
		}
		if (entry.stableCore !== undefined && entry.stableCore !== true) { problems.push(`${where}: stableCore is true or absent.`); }
		if (entry.stableCore === true && (!isCore(entry.params) || (entry.result !== null && !isCore(entry.result)))) {
			problems.push(`${where}: a stable-core method's params and result are stable-core definitions.`);
		}
		const kinds: unknown = entry.callableBy;
		if (!Array.isArray(kinds) || kinds.length === 0 || new Set(kinds).size !== kinds.length || kinds.some((k) => !clientKinds.includes(k))) {
			problems.push(`${where}: callableBy lists distinct client kinds from ClientKind.`);
		}
	}
	for (const [name, entry] of Object.entries(table.notifications)) {
		if (!isMessage(entry.payload)) { problems.push(`notification ${name}: payload ${entry.payload} is not an object definition.`); }
	}
	for (const [name, entry] of Object.entries(table.clientRequests)) {
		if (!isMessage(entry.params) || !isMessage(entry.result)) { problems.push(`client request ${name}: params and result are object definitions.`); }
	}
	const numbers = Object.values(table.errorFamilies).map((f) => f.number);
	if (numbers.some((n) => !Number.isInteger(n)) || new Set(numbers).size !== numbers.length) {
		problems.push('methods.json: error family numbers are distinct integers.');
	}
	for (const [code, entry] of Object.entries(table.errors)) {
		if (!(entry.family in table.errorFamilies)) { problems.push(`error ${code}: family ${entry.family} is not in errorFamilies.`); }
	}
	const sameSet = (a: readonly unknown[], b: readonly unknown[]): boolean => a.length === b.length && a.every((x) => b.includes(x));
	if (!sameSet((definitions.ErrorCode as Schema | undefined)?.enum ?? [], Object.keys(table.errors))) {
		problems.push('ErrorCode in the schema and errors in methods.json list different codes.');
	}
	if (!sameSet((definitions.ErrorFamily as Schema | undefined)?.enum ?? [], Object.keys(table.errorFamilies))) {
		problems.push('ErrorFamily in the schema and errorFamilies in methods.json list different families.');
	}

	const cliKeys = new Set<unknown>();
	for (const [key, rule] of Object.entries((definitions.Settings as Schema | undefined)?.properties ?? {})) {
		const where = `Settings.${key}`;
		if (typeof rule['x-cliKey'] !== 'string' || cliKeys.has(rule['x-cliKey'])) { problems.push(`${where}: x-cliKey is a distinct string.`); }
		cliKeys.add(rule['x-cliKey']);
		if (typeof rule['x-dangerous'] !== 'boolean') { problems.push(`${where}: x-dangerous is true or false.`); }
		if (rule['x-stored'] !== undefined && typeof rule['x-stored'] !== 'boolean') { problems.push(`${where}: x-stored is true, false or absent.`); }
		if (!('default' in rule) || typeof rule.description !== 'string') { problems.push(`${where}: a setting has a default and a description.`); }
		if (!['boolean', 'number', 'integer', 'string'].includes(rule.type as string)) { problems.push(`${where}: a setting is a boolean, number, integer or string.`); }
	}
	return problems;
}

// ── Compatibility with the last release ─────────────────────────────

function resolve(schema: Schema, definitions: Definitions): Schema {
	let current: Schema | undefined = schema;
	for (let i = 0; i < 32 && current && current.$ref; i++) { current = definitions[String(refName(current))]; }
	return current ?? {};
}

function shapeOf(schema: Schema): string {
	if (schema.oneOf) { return 'union'; }
	if (schema.type !== undefined) { return ([] as string[]).concat(schema.type).sort().join('|'); }
	if (schema.properties) { return 'object'; }
	if ('const' in schema) { return 'const'; }
	return 'any';
}

/** The definitions of the release and of now, which every comparison resolves its `$ref`s in. */
interface CompareContext {
	before: Definitions;
	after: Definitions;
}

/**
 * Pushes every breaking difference between a released schema and the current one onto `out`.
 * `strict` also counts a new enum value or union variant as breaking: for what the daemon reads
 * (request parameters, a question's answer, the files) and for the stable core, since an older
 * daemon or client cannot parse a value it does not know. Clients read results and notifications
 * leniently, so there a new value is additive.
 */
function compareSchemas(before: Schema, after: Schema, where: string, ctx: CompareContext, strict: boolean, out: string[], seen = new Set<string>()): void {
	if (before.$ref || after.$ref) {
		const pair = `${before.$ref}>${after.$ref}`;
		if (seen.has(pair)) { return; }
		seen = new Set(seen).add(pair);
	}
	const b = resolve(before, ctx.before);
	const a = resolve(after, ctx.after);
	const shapeB = shapeOf(b);
	const shapeA = shapeOf(a);
	if (shapeB !== shapeA) { out.push(`${where}: type changed from ${shapeB} to ${shapeA}.`); return; }
	if ('const' in b && b.const !== a.const) { out.push(`${where}: const changed.`); }
	if (Array.isArray(b.enum) || Array.isArray(a.enum)) {
		const was = b.enum ?? [];
		const now = a.enum ?? [];
		for (const value of was) { if (!now.includes(value)) { out.push(`${where}: value ${JSON.stringify(value)} removed.`); } }
		if (strict) { for (const value of now) { if (!was.includes(value)) { out.push(`${where}: value ${JSON.stringify(value)} added, which an older reader cannot parse.`); } } }
	}
	if (shapeB === 'union') {
		const tagB = unionTag(b);
		const tagA = unionTag(a);
		if (tagB !== tagA) { out.push(`${where}: union tag changed from ${tagB} to ${tagA}.`); return; }
		const byTag = (s: Schema): Map<unknown, Schema> => new Map((s.oneOf as Schema[]).map((branch) => [(branch.properties as Record<string, Schema>)[tagB as string].const, branch]));
		const was = byTag(b);
		const now = byTag(a);
		for (const [value, branch] of was) {
			const current = now.get(value);
			if (!now.has(value) || current === undefined) { out.push(`${where}: variant ${JSON.stringify(value)} removed.`); continue; }
			compareSchemas(branch, current, `${where}<${String(value)}>`, ctx, strict, out, seen);
		}
		if (strict) { for (const value of now.keys()) { if (!was.has(value)) { out.push(`${where}: variant ${JSON.stringify(value)} added, which an older reader cannot parse.`); } } }
		return;
	}
	if (b.properties || a.properties) {
		const reqB = new Set(b.required ?? []);
		const reqA = new Set(a.required ?? []);
		for (const [name, property] of Object.entries(b.properties ?? {})) {
			if (!a.properties || !(name in a.properties)) { out.push(`${where}.${name}: field removed or renamed.`); continue; }
			if (reqB.has(name) && !reqA.has(name)) { out.push(`${where}.${name}: field became optional.`); }
			if (!reqB.has(name) && reqA.has(name)) { out.push(`${where}.${name}: field became required.`); }
			compareSchemas(property, a.properties[name], `${where}.${name}`, ctx, strict, out, seen);
		}
		for (const name of Object.keys(a.properties ?? {})) {
			if (!(b.properties && name in b.properties) && reqA.has(name)) { out.push(`${where}.${name}: new required field.`); }
		}
	}
	if (b.items || a.items) { compareSchemas((b.items ?? {}) as Schema, (a.items ?? {}) as Schema, `${where}[]`, ctx, strict, out, seen); }
	const mapB = typeof b.additionalProperties === 'object' ? b.additionalProperties : undefined;
	const mapA = typeof a.additionalProperties === 'object' ? a.additionalProperties : undefined;
	if (mapB || mapA) { compareSchemas(mapB ?? {}, mapA ?? {}, `${where}{}`, ctx, strict, out, seen); }
}

const refTo = (name: string): Schema => ({ $ref: `#/definitions/${name}` });

/** Breaking changes since the release, and those among them that touch the stable core. */
export function compareWithRelease(released: Contract, current: Contract): { breaking: string[]; core: string[] } {
	const breaking: string[] = [];
	const core: string[] = [];
	const ctx: CompareContext = { before: released.definitions, after: current.definitions };
	const compareRoot = (bName: string | null | undefined, aName: string | null | undefined, where: string, onCore: boolean, daemonReads: boolean): void => {
		const target = onCore ? core : breaking;
		if (bName === null || aName === null) {
			if (bName !== aName) { target.push(`${where}: changed between null and ${bName ?? aName}.`); }
			return;
		}
		compareSchemas(refTo(String(bName)), refTo(String(aName)), where, ctx, onCore || daemonReads, target);
	};
	// Each part with whether the daemon is its reader.
	const sections: [string, Record<string, boolean>][] = [
		['hello', { params: true, result: false }],
		['methods', { params: true, result: false }],
		['notifications', { payload: false }],
		['clientRequests', { params: false, result: true }],
	];
	for (const [section, parts] of sections) {
		const was = (released.table[section] ?? {}) as Record<string, Record<string, unknown>>;
		const now = (current.table[section] ?? {}) as Record<string, Record<string, unknown>>;
		for (const [name, entry] of Object.entries(was)) {
			const onCore = section === 'hello' || entry.stableCore === true;
			const target = onCore ? core : breaking;
			if (!(name in now)) { target.push(`${section} ${name}: removed or renamed.`); continue; }
			for (const [part, daemonReads] of Object.entries(parts)) {
				compareRoot(entry[part] as string | null | undefined, now[name][part] as string | null | undefined, `${section} ${name} ${part}`, onCore, daemonReads);
			}
			if (section === 'methods') {
				for (const kind of (entry.callableBy ?? []) as string[]) {
					if (!((now[name].callableBy ?? []) as string[]).includes(kind)) { target.push(`methods ${name}: no longer callable by ${kind}.`); }
				}
			}
		}
	}
	// The stable core, and the files (which a daemon or client of another version may read).
	for (const [name, definition] of Object.entries(released.definitions)) {
		const onCore = definition['x-stableCore'] === true;
		if (!onCore && definition['x-file'] === undefined) { continue; }
		const target = onCore ? core : breaking;
		if (!(name in current.definitions)) { target.push(`${name}: removed or renamed.`); continue; }
		compareSchemas(refTo(name), refTo(name), name, ctx, true, target);
	}
	for (const [code, entry] of Object.entries(released.table.errors ?? {})) {
		const now = (current.table.errors as Record<string, ErrorEntry> | undefined)?.[code];
		if (!now) { breaking.push(`error ${code}: removed or renamed.`); continue; }
		if (now.family !== entry.family) { breaking.push(`error ${code}: moved from family ${entry.family} to ${now.family}.`); }
	}
	for (const [family, entry] of Object.entries(released.table.errorFamilies ?? {})) {
		const now = (current.table.errorFamilies as Record<string, FamilyEntry> | undefined)?.[family];
		if (!now) { breaking.push(`error family ${family}: removed or renamed.`); continue; }
		if (now.number !== entry.number) { breaking.push(`error family ${family}: number changed.`); }
	}
	for (const family of Object.keys(current.table.errorFamilies ?? {})) {
		if (!(family in (released.table.errorFamilies ?? {}))) { breaking.push(`error family ${family}: new family.`); }
	}
	return { breaking, core };
}

/** Problems with the contract version, and a note when there is nothing to compare with. */
function versionProblems(contractDir: string, current: Contract): { problems: string[]; notes: string[] } {
	const released = loadReleased(contractDir);
	if (!released) { return { problems: [], notes: [NO_SNAPSHOT] }; }
	const { breaking, core } = compareWithRelease(released, current);
	const problems = core.map((p) => `stable core: ${p} The stable core only ever gains optional properties.`);
	const was = released.table.contractVersion;
	const now = current.table.contractVersion;
	if (now < was) { problems.push(`contractVersion ${now} is lower than the released ${was}.`); }
	if (breaking.length > 0 && now <= was) {
		problems.push(`Breaking changes since the release need contractVersion above ${was}:`, ...breaking.map((p) => `  ${p}`));
	}
	return { problems, notes: [] };
}

// ── TypeScript output ───────────────────────────────────────────────

function banner(hash: string): string {
	return [
		'/* eslint-disable */',
		'/**',
		' * Generated by scripts/generate-contract.mts from contract/; do not edit by hand.',
		` * Schema hash: sha256:${hash}`,
		' */',
		'',
	].join('\n');
}

function jsdoc(text: string | undefined, indent: string): string {
	if (!text) { return ''; }
	return `${indent}/** ${text.replace(/\*\//g, '*\\/')} */\n`;
}

function settingSpecs(definitions: Definitions): Record<string, unknown>[] {
	return Object.entries((definitions.Settings as Schema | undefined)?.properties ?? {}).map(([key, rule]) => {
		const spec: Record<string, unknown> = { key, cliKey: rule['x-cliKey'], type: rule.type, default: rule.default };
		for (const name of ['minimum', 'exclusiveMinimum', 'maximum', 'enum']) {
			if (rule[name] !== undefined) { spec[name] = rule[name]; }
		}
		Object.assign(spec, { description: rule.description, dangerous: rule['x-dangerous'], stored: rule['x-stored'] ?? true });
		return spec;
	});
}

function literal(value: unknown, indent: string): string {
	return JSON.stringify(value, null, '\t').replace(/\n/g, `\n${indent}`);
}

function renderMethods(contract: Contract, hash: string): string {
	const { table, definitions } = contract;
	const used = new Set(['ClientKind', 'ErrorCode', 'ErrorFamily', 'SettingSpec']);
	const typeOf = (name: string | null): string => { if (name === null) { return 'null'; } used.add(name); return name; };
	const q = (name: string): string => `'${name}'`;
	const lines: string[] = [];

	lines.push('/** The contract version: raised only by a breaking change to the contract. */');
	lines.push(`export const CONTRACT_VERSION = ${table.contractVersion};`, '');

	lines.push('/** The hello that opens every connection, before any other request. */');
	lines.push('export interface HelloMethods {');
	for (const [name, entry] of Object.entries(table.hello)) {
		lines.push(`${jsdoc(entry.doc, '\t')}\t${q(name)}: { params: ${typeOf(entry.params)}; result: ${typeOf(entry.result)} };`);
	}
	lines.push('}', '');
	for (const name of Object.keys(table.hello)) {
		lines.push(`export const ${name.replace(/\W/g, '_').replace(/[A-Z]/g, (c) => `_${c}`).toUpperCase()} = ${q(name)};`);
	}
	lines.push('');

	lines.push('/** Every request a client may send, with its parameters and result. */');
	lines.push('export interface Methods {');
	for (const [name, entry] of Object.entries(table.methods)) {
		lines.push(`${jsdoc(entry.doc, '\t')}\t${q(name)}: { params: ${typeOf(entry.params)}; result: ${typeOf(entry.result)} };`);
	}
	lines.push('}', '');
	lines.push('export type MethodName = keyof Methods;');
	lines.push('export type ParamsOf<M extends MethodName> = Methods[M][\'params\'];');
	lines.push('export type ResultOf<M extends MethodName> = Methods[M][\'result\'];', '');

	lines.push('/** What the method table says about a request. */');
	lines.push('export interface MethodInfo {');
	lines.push('\t/** Takes the brick\'s write lease for exactly its own length. */');
	lines.push('\treadonly leased: boolean;');
	lines.push('\t/** Runs only after a person said yes, in every case or in some, as the method\'s doc says. */');
	lines.push('\treadonly needsPerson: boolean;');
	lines.push('\t/** Part of the stable core: readable by every client and daemon version. */');
	lines.push('\treadonly stableCore: boolean;');
	lines.push('\t/** The client kinds that may send it. */');
	lines.push('\treadonly callableBy: readonly ClientKind[];');
	lines.push('}', '');
	lines.push('export const METHODS: { readonly [M in MethodName]: MethodInfo } = {');
	for (const [name, entry] of Object.entries(table.methods)) {
		const kinds = entry.callableBy.map(q).join(', ');
		lines.push(`\t${q(name)}: { leased: ${entry.leased}, needsPerson: ${entry.needsPerson}, stableCore: ${entry.stableCore === true}, callableBy: [${kinds}] },`);
	}
	lines.push('};', '');

	lines.push('/** Every notification the daemon sends, with its payload. Within a connection they arrive in the order the daemon raised them. */');
	lines.push('export interface Notifications {');
	for (const [name, entry] of Object.entries(table.notifications)) {
		lines.push(`${jsdoc(entry.doc, '\t')}\t${q(name)}: ${typeOf(entry.payload)};`);
	}
	lines.push('}', '');
	lines.push('export type NotificationName = keyof Notifications;', '');

	lines.push('/** The requests the daemon sends a client. */');
	lines.push('export interface ClientRequests {');
	for (const [name, entry] of Object.entries(table.clientRequests)) {
		lines.push(`${jsdoc(entry.doc, '\t')}\t${q(name)}: { params: ${typeOf(entry.params)}; result: ${typeOf(entry.result)} };`);
	}
	lines.push('}', '');

	lines.push('/** The family of every error code. */');
	lines.push('export const ERROR_FAMILY: { readonly [C in ErrorCode]: ErrorFamily } = {');
	for (const [code, entry] of Object.entries(table.errors)) { lines.push(`${jsdoc(entry.doc, '\t')}\t${code}: ${q(entry.family)},`); }
	lines.push('};', '');
	lines.push('/** The JSON-RPC error code that names each family. */');
	lines.push('export const ERROR_FAMILY_NUMBER: { readonly [F in ErrorFamily]: number } = {');
	for (const [family, entry] of Object.entries(table.errorFamilies)) { lines.push(`${jsdoc(entry.doc, '\t')}\t${family}: ${entry.number},`); }
	lines.push('};', '');

	for (const open of openEnums(definitions)) {
		used.add(open.name);
		lines.push(`/** Reads a stable-core string as a ${open.name}; a value this version does not know reads as ${q(String(open.fallback))}. */`);
		lines.push(`export function read${open.name}(value: string): ${open.name} {`);
		lines.push(`\treturn ([${open.values.map(q).join(', ')}] as readonly string[]).includes(value) ? value as ${open.name} : ${q(String(open.fallback))};`);
		lines.push('}', '');
	}

	lines.push('/** Every setting with its rules, as the Settings definition gives them. */');
	lines.push(`export const SETTING_SPECS: readonly SettingSpec[] = ${literal(settingSpecs(definitions), '')};`);

	const imports = [...used].sort();
	return [
		banner(hash),
		`import type {\n${imports.map((n) => `\t${n},`).join('\n')}\n} from './types';`,
		'',
		...lines,
		'',
	].join('\n');
}

async function renderTypes(contract: Contract, hash: string): Promise<string> {
	const { compile } = require('json-schema-to-typescript') as typeof import('json-schema-to-typescript');
	const schema = JSON.parse(JSON.stringify({
		$schema: DRAFT,
		title: 'ContractDefinitions',
		description: 'Every definition of the contract; this root type itself carries nothing.',
		type: 'object',
		properties: {},
		definitions: contract.definitions,
	})) as Parameters<typeof compile>[0];
	const ts = await compile(schema, 'ContractDefinitions', {
		bannerComment: '',
		additionalProperties: false,
		unreachableDefinitions: true,
		declareExternallyReferenced: true,
		strictIndexSignatures: false,
		format: true,
		style: { singleQuote: true, useTabs: true, printWidth: 120, endOfLine: 'lf' },
	});
	return `${banner(hash)}\n${ts.trim()}\n`;
}

async function render(contract: Contract): Promise<Record<string, string>> {
	const hash = schemaHash(contract);
	return {
		'types.ts': await renderTypes(contract, hash),
		'methods.ts': renderMethods(contract, hash),
		'index.ts': `${banner(hash)}\nexport * from './types';\nexport * from './methods';\n`,
	};
}

// ── Commands ────────────────────────────────────────────────────────

/** Every problem with the contract: broken rules and unraised breaking changes. */
function problemsOf(contractDir: string, contract: Contract): { problems: string[]; notes: string[] } {
	const problems = lint(contract);
	if (problems.length > 0) { return { problems, notes: [] }; }
	return versionProblems(contractDir, contract);
}

/** Writes the TypeScript side; refuses, writing nothing, when the contract has problems. */
export async function generate(paths: Paths = {}): Promise<Outcome> {
	const { contractDir, outDir } = { ...DEFAULT_PATHS, ...paths };
	const contract = loadContract(contractDir);
	const { problems, notes } = problemsOf(contractDir, contract);
	if (problems.length > 0) { return { ok: false, problems, notes, written: [] }; }
	const files = await render(contract);
	fs.mkdirSync(outDir, { recursive: true });
	for (const [name, content] of Object.entries(files)) { fs.writeFileSync(path.join(outDir, name), content); }
	return { ok: true, problems: [], notes, written: Object.keys(files) };
}

/** Checks the contract and that every generated file is what the schema gives now. */
export async function check(paths: Paths = {}): Promise<Outcome> {
	const { contractDir, outDir } = { ...DEFAULT_PATHS, ...paths };
	const contract = loadContract(contractDir);
	const { problems, notes } = problemsOf(contractDir, contract);
	if (problems.length > 0) { return { ok: false, problems, notes }; }
	const files = await render(contract);
	const stale: string[] = [];
	for (const [name, content] of Object.entries(files)) {
		const file = path.join(outDir, name);
		const onDisk = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : undefined;
		if (onDisk !== content) { stale.push(`${path.relative(ROOT, file).split(path.sep).join('/')} is stale: run node scripts/generate-contract.mts.`); }
	}
	return { ok: stale.length === 0, problems: stale, notes };
}

/** Records the contract as released, for the next release's comparison. */
export function snapshot(paths: Paths = {}): Outcome {
	const { contractDir } = { ...DEFAULT_PATHS, ...paths };
	const contract = loadContract(contractDir);
	const problems = lint(contract);
	if (problems.length > 0) { return { ok: false, problems }; }
	const dir = path.join(contractDir, 'released');
	fs.mkdirSync(dir, { recursive: true });
	fs.writeFileSync(path.join(dir, 'schema.json'), `${JSON.stringify({ $schema: DRAFT, definitions: contract.definitions }, null, 2)}\n`);
	fs.writeFileSync(path.join(dir, 'methods.json'), `${JSON.stringify(contract.table, null, 2)}\n`);
	return { ok: true, problems: [] };
}

type Mode = 'generate' | 'check' | 'snapshot';

async function main(argv: readonly string[]): Promise<number> {
	const mode: Mode = argv.includes('--check') ? 'check' : argv.includes('--snapshot') ? 'snapshot' : 'generate';
	const result = mode === 'check' ? await check() : mode === 'snapshot' ? snapshot() : await generate();
	for (const note of result.notes ?? []) { process.stdout.write(`${note}\n`); }
	for (const problem of result.problems) { process.stderr.write(`${problem}\n`); }
	if (result.ok) {
		const done: Record<Mode, string> = { generate: `Wrote ${(result.written ?? []).join(', ')} to src/contract/generated/.`, check: 'The contract and its generated files are current.', snapshot: 'Recorded the contract in contract/released/.' };
		process.stdout.write(`${done[mode]}\n`);
	}
	return result.ok ? 0 : 1;
}

/** Whether this file is the script node was started with, rather than a module another one loads. */
function startedDirectly(): boolean {
	const entry = process.argv[1];
	try {
		return entry !== undefined && fs.realpathSync.native(entry) === fs.realpathSync.native(import.meta.filename);
	} catch {
		return false;
	}
}

if (startedDirectly()) {
	main(process.argv.slice(2)).then((code) => { process.exitCode = code; }, (error: unknown) => { process.stderr.write(`${(error as Error | undefined)?.stack ?? String(error)}\n`); process.exitCode = 1; });
}
