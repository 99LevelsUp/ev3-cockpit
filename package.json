{
  "name": "ev3-cockpit",
  "displayName": "EVƎ Cockpit",
  "description": "VS Code extension for EV3 brick discovery, connection, and monitoring",
  "version": "0.2.470",
  "publisher": "99LevelsUp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/99LevelsUp/ev3-cockpit"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The cockpit runs nothing from the workspace, and its settings live in the cockpit daemon, not in the workspace."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ev3-cockpit.listProjects",
        "title": "List Projects on Active Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.showStorage",
        "title": "Show Storage on Active Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.connectBrick",
        "title": "Connect a Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.disconnectBrick",
        "title": "Disconnect a Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.forgetBrick",
        "title": "Forget a Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.clearBrickBluetoothList",
        "title": "Clear a Brick's Bluetooth List",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.settings",
        "title": "Settings",
        "category": "EVƎ"
      },
      {
        "command": "ev3-cockpit.restartDaemon",
        "title": "Restart the Cockpit Daemon",
        "category": "EVƎ"
      }
    ]
  },
  "scripts": {
    "compile": "tsc",
    "lint": "eslint src --ext .ts",
    "build:helper": "dotnet publish native/bt-pairing-helper -c Release -o native/bin",
    "build:helper:macos": "mkdir -p native/bin && swiftc -O -o native/bin/ev3-bt-helper native/macos/ev3-bt-helper.swift",
    "build:dev": "node scripts/bundle.cjs --sourcemap",
    "package": "npm run build:helper && npm run bundle",
    "bundle": "node scripts/bundle.cjs",
    "test:unit": "node scripts/run-unit-tests.cjs",
    "test-smoke": "npm run test:unit",
    "test:host": "npm run bundle && node scripts/runTests.js",
    "test:ci": "npm run compile && npm run lint && npm run test:unit && npm run test:host",
    "test:ci:release": "npm run compile && npm run lint && npm run test:unit && npm run test:host && npm run package",
    "test:pw:smoke": "playwright test tests/smoke.spec.ts",
    "package:vsix": "node scripts/package-vsix.cjs",
    "package:npm": "node scripts/package-npm.cjs",
    "smoke:daemon": "node scripts/daemon-smoke.cjs",
    "watch": "tsc --watch",
    "watch:bundle": "esbuild src/vscode/extension.ts --bundle --platform=node --target=node20 --external:vscode --external:node-hid --external:serialport --external:koffi --external:usb --outfile=out/extension.js --sourcemap --watch",
    "prepare": "node scripts/install-hooks.cjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "koffi": "^3.1.6",
    "node-hid": "3.3.0",
    "serialport": "13.0.0",
    "usb": "^2.17.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "vscode-jsonrpc": "10.0.0",
    "zod": "4.6.7"
  }
}
