{
  "name": "ev3-cockpit",
  "displayName": "EVƎ Cockpit",
  "description": "VS Code extension for EV3 brick discovery, connection, and monitoring",
  "version": "0.3.2-preview.1",
  "publisher": "99LevelsUp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/99LevelsUp/ev3-cockpit"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The cockpit runs nothing from the workspace, and its settings live in the cockpit daemon, not in the workspace."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ev3-cockpit.listProjects",
        "title": "List Projects on Active Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.showStorage",
        "title": "Show Storage on Active Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.connectBrick",
        "title": "Connect a Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.disconnectBrick",
        "title": "Disconnect a Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.forgetBrick",
        "title": "Forget a Brick",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.clearBrickBluetoothList",
        "title": "Clear a Brick's Bluetooth List",
        "category": "EV3 Cockpit"
      },
      {
        "command": "ev3-cockpit.settings",
        "title": "Settings",
        "category": "EVƎ"
      },
      {
        "command": "ev3-cockpit.restartDaemon",
        "title": "Restart the Cockpit Daemon",
        "category": "EVƎ"
      }
    ]
  },
  "scripts": {
    "compile": "tsc && node scripts/bundle.mts api-check",
    "lint": "eslint src --ext .ts && tsc -p tsconfig.scripts.json",
    "contract:generate": "node scripts/generate-contract.mts",
    "contract:check": "node scripts/generate-contract.mts --check",
    "contract:snapshot": "node scripts/generate-contract.mts --snapshot",
    "build:dev": "node scripts/bundle.mts --sourcemap",
    "package": "npm run bundle",
    "bundle": "node scripts/bundle.mts",
    "test:unit": "node scripts/run-unit-tests.mts",
    "test-smoke": "npm run test:unit",
    "test:host": "npm run bundle && node scripts/runTests.mts",
    "test:ci": "npm run compile && npm run lint && npm run contract:check && npm run test:unit && npm run test:host",
    "test:ci:release": "npm run test:ci && npm run package",
    "test:pw:smoke": "playwright test tests/smoke.spec.ts",
    "package:vsix": "node scripts/package-vsix.mts",
    "package:npm": "node scripts/package-npm.mts",
    "smoke:daemon": "node scripts/daemon-smoke.mts",
    "daemon:build": "cd daemon && cargo build -p ev3-cockpitd -p ev3-cli && cd .. && node scripts/daemon-manifest.mts",
    "daemon:build:release": "cd daemon && cargo build --release -p ev3-cockpitd -p ev3-cli && cd .. && node scripts/daemon-manifest.mts --profile release",
    "daemon:manifest": "node scripts/daemon-manifest.mts",
    "watch": "tsc --watch",
    "watch:bundle": "esbuild src/vscode/extension.ts --bundle --platform=node --target=node20 --external:vscode --external:node-hid --external:serialport --external:koffi --external:usb --outfile=out/extension.js --sourcemap --watch",
    "prepare": "node scripts/install-hooks.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "vscode-jsonrpc": "10.0.0"
  }
}
