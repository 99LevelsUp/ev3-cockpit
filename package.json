{
  "name": "ev3-cockpit",
  "displayName": "EVƎ Cockpit",
  "description": "VS Code extension for EV3 brick discovery, connection, and monitoring",
  "version": "0.2.82",
  "publisher": "99LevelsUp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/99LevelsUp/ev3-cockpit"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ev3-cockpit.listProjects",
        "title": "List Projects on Active Brick",
        "category": "EVƎ Cockpit"
      },
      {
        "command": "ev3-cockpit.showStorage",
        "title": "Show Storage on Active Brick",
        "category": "EVƎ Cockpit"
      }
    ]
  },
  "scripts": {
    "compile": "tsc",
    "lint": "eslint src --ext .ts",
    "build:dev": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --external:node-hid --external:serialport --external:koffi --external:regkey --external:usb --outfile=out/extension.js --sourcemap",
    "package": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --external:node-hid --external:serialport --external:koffi --external:regkey --external:usb --outfile=out/extension.js",
    "test:unit": "node scripts/run-unit-tests.cjs",
    "test-smoke": "npm run test:unit",
    "test:host": "node scripts/runTests.js",
    "test:ci": "npm run compile && npm run lint && npm run test:unit && npm run test:host",
    "test:ci:release": "npm run compile && npm run lint && npm run test:unit && npm run test:host && npm run package",
    "test:pw:smoke": "playwright test tests/smoke.spec.ts",
    "package:vsix": "vsce package",
    "watch": "tsc --watch",
    "watch:bundle": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --external:node-hid --external:serialport --external:koffi --external:regkey --external:usb --outfile=out/extension.js --sourcemap --watch",
    "prepare": "node scripts/install-hooks.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "koffi": "^3.1.6",
    "node-hid": "3.3.0",
    "regkey": "2.3.3",
    "serialport": "13.0.0",
    "usb": "^2.17.0"
  }
}
